GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MOCK_MODE=true

# Local hosting port; also used to build the OAuth redirect URI below.
PORT=8000

# Base URL used to build the accept/decline/tentative links embedded in
# proposal emails. Change this to your real deployed URL once you're off
# localhost.
APP_BASE_URL=http://localhost:8000

# Secret used to sign those response links (HMAC-SHA256) so they can't be
# forged or tampered with. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RESPONSE_TOKEN_SECRET=

# OAuth client (type: Web application) from Google Cloud Console.
# Add this exact URI under "Authorized redirect URIs" for that client:
#   http://localhost:8000/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth2callback
