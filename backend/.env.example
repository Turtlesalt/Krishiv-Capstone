GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MOCK_MODE=true

# API key for Google Places API (New) - powers find_nearby_places when
# MOCK_MODE=false. Enable "Places API (New)" on your Google Cloud project
# (console.cloud.google.com/apis/library/places.googleapis.com - the same
# project used for the OAuth client below is fine) and create an API key
# under APIs & Services > Credentials. Needs billing enabled on the project,
# but this app's usage is well within the free monthly credit.
GOOGLE_PLACES_API_KEY=AIzaSyAVAx82mK2WoJ4sQlwdTxv72e_7jIC1Epo
# Local hosting port; also used to build the OAuth redirect URI below.
PORT=8000

# Base URL used to build the accept/decline/tentative links embedded in
# proposal emails. Change this to your real deployed URL once you're off
# localhost.
APP_BASE_URL=http://localhost:8000

# Secret used to sign those response links (HMAC-SHA256) so they can't be
# forged or tampered with. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RESPONSE_TOKEN_SECRET=

# OAuth client (type: Web application) from Google Cloud Console.
# Add this exact URI under "Authorized redirect URIs" for that client:
#   http://localhost:8000/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth2callback
